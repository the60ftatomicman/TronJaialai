   1086  f562							; GetRandomColor
   1087  f562							; Generates a pseudo-random value using a Linear Feedback Shift Register
   1088  f562							; Returns: A = random value, NextColor = random value - 1 (for 0-6 range)
   1089  f562							; Modifies: Random variable
   1090  f562				   GetRandomColor
   1091  f562		       a5 87		      lda	Random
   1092  f564		       4a		      lsr
   1093  f565		       90 02		      bcc	.GetRandomColor.noXor
   1094  f567		       49 b8		      eor	#$B8
   1095  f569				   .GetRandomColor.noXor
   1096  f569		       d0 02		      bne	.GetRandomColor.done	; If not 0, done
   1097  f56b		       a9 01		      lda	#$01
   1098  f56d				   .GetRandomColor.done
   1099  f56d		       85 87		      sta	Random
   1100  f56f				   .GetRandomColor.convert
   1101  f56f		       29 07		      and	#$07
   1102  f571		       c9 07		      cmp	#$07
   1103  f573		       b0 ed		      bcs	GetRandomColor
   1104  f575				   .GetRandomColor.convert.done
   1105  f575		       38		      sec
   1106  f576		       e9 01		      sbc	#$01
   1107  f578		       85 84		      sta	NextColor
   1108  f57a		       60		      rts
   1109  f57b
   1110  f57b							;;;;;;;;;;;;;;;;;;;;;;;
   1111  f57b							; GetRandomQueue
   1112  f57b							; Generates a pseudo-random value using a Linear Feedback Shift Register
   1113  f57b							; Returns: A = random value, NextColumn = random value - 1 (for 0-10 range)
   1114  f57b							; Modifies: Random variable	
   1115  f57b				   GetRandomQueue
   1116  f57b		       a5 87		      lda	Random
   1117  f57d		       4a		      lsr
   1118  f57e		       90 02		      bcc	.GetRandomQueue.noXor
   1119  f580		       49 b8		      eor	#$B8
   1120  f582				   .GetRandomQueue.noXor
   1121  f582		       d0 02		      bne	.GetRandomQueue.done	; If not 0, done
   1122  f584		       a9 01		      lda	#$01
   1123  f586				   .GetRandomQueue.done
   1124  f586		       85 87		      sta	Random
   1125  f588				   .GetRandomQueue.convert
   1126  f588		       29 0f		      and	#$0F
   1127  f58a		       c9 0a		      cmp	#$0A
   1128  f58c		       b0 ed		      bcs	GetRandomQueue
   1129  f58e				   .GetRandomQueue.convert.done
   1130  f58e		       85 85		      sta	NextColumn
   1131  f590		       60		      rts
