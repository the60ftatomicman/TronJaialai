     40  0000 ????						;--------
     41  0000 ????						; FLIP_BOOL
     42  0000 ????						; Original author: Andy Garber
     43  0000 ????						; Takes a memory address and flips it's value than stores it
     44  0000 ????						; Assumes the Memory address value is 1 or 0
     45  0000 ????						; usage: FLIP_BOOL SomeAddress
     46  0000 ????				      MAC	flip_bool
     47  0000 ????			   .MEMADDR   SET	{1}
     48  0000 ????				      lda	.MEMADDR
     49  0000 ????				      EOR	#$01
     50  0000 ????				      sta	.MEMADDR
     51  0000 ????				      ENDM
     52  0000 ????
     53  0000 ????						;--------
     54  0000 ????						; LOAD_POINTER_WITH_DATA
     55  0000 ????						; Original author: Andy Garber
     56  0000 ????						; Loads a pointer with low byte than high byte address of data object
     57  0000 ????						; usage: LOAD_POINTER_WITH_DATA pointer data
     58  0000 ????				      MAC	load_pointer_with_data
     59  0000 ????			   .POINTER   SET	{1}
     60  0000 ????			   .DATA_BLOB SET	{2}
     61  0000 ????				      lda	#<.DATA_BLOB
     62  0000 ????				      sta	.POINTER
     63  0000 ????				      lda	#>.DATA_BLOB
     64  0000 ????				      sta	.POINTER+1
     65  0000 ????				      ENDM
     66  0000 ????						;--------
     67  0000 ????						; WYSNC_REPEATER
     68  0000 ????						; Original author: Andy Garber
     69  0000 ????						; just a wrapper around REPEAT X lines of WSYNC. used to help with spacing in this game.
     70  0000 ????				      MAC	wysnc_repeater
     71  0000 ????			   .LINES_TO_WAIT SET	{1}
     72  0000 ????				      REPEAT	.LINES_TO_WAIT
     73  0000 ????				      sta	WSYNC
     74  0000 ????				      REPEND
     75  0000 ????				      ENDM
     76  0000 ????						;--------
     77  0000 ????						; START_FRAME
     78  0000 ????						; Original author: Andy Garber
