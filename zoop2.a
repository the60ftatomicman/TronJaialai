    processor 6502
    include "./includes/vcs.h"
    include "./includes/macro.h"
    include "./includes/xmacro.h"
    include "./includes/colors.h"
    include "./includes/constants.h"
    include "./includes/zoop/zoop_macros.h"
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constants segment
; ---- COLOR MAPPING TO OBJECT
CONS_GRID_BRICKS_BG    EQU CONS_COLOR_GREY_C
CONS_GRID_CLIFF_BG     EQU CONS_COLOR_GREY_7
CONS_PLAYERZONE_PF     EQU CONS_COLOR_GREY
CONS_PLAYERZONE_ACTION EQU CONS_COLOR_WHITE
CONS_PLAYERZONE_NOACT  EQU CONS_COLOR_LGREY
CONS_SCORE_POSITIVE    EQU CONS_COLOR_GREEN
CONS_SCORE_NEGATIVE    EQU CONS_COLOR_RED
CONS_TIME_BG           EQU CONS_COLOR_PURPLE
CONS_COLOR_COUNT       EQU #6               ;-- See DATA/Colors for the actual list
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Variables segment

    seg.u Variables
    org $80
CONS_BQ_VERT_COLS        EQU #5
CONS_BQ_VERT_ROWS        EQU #5
CONS_BQ_VERT_ROW_HEIGHT  EQU #4
;
CONS_CLIFF_HEIGHT        EQU #5
CONS_CLIFF_SHADING_GAP   EQU #2
;
CONS_PLAYERZ_COLS        EQU #6
CONS_PLAYERZ_ROWS        EQU #3
CONS_PLAYERZ_ROW_HEIGHT  EQU #8
;
CONS_SCORE_LEFTMOST_DIGIT_X EQU #$33
CONS_SCORE_MINUS_SIGN_X     EQU #$20
;
CONS_TIMER_FRAMES_PER_SEC EQU #20
;
CONS_GAMESTATE_TITLE      EQU #00
CONS_GAMESTATE_GAMEOVER   EQU #01
CONS_GAMESTATE_PLAY       EQU #02
;
TempByte_a .byte
TempByte_b .byte
TempByte_c .byte
TempByte_d .byte
TempPtr_a    .DS 2
TempPtr_b    .DS 2
TempPtr_c    .DS 2
TempPtr_d    .DS 2
;
NextColorTimerIdx .byte
NextColorCounter  .byte
NextColor         .byte
NextColumn        .byte
;
FrameCount .byte
Random     .byte
;
PlaySoundCounter .byte
PlaySoundIdx .byte
;
Player0Pos_Col .byte
Player0Pos_Row .byte
Player0_Color  .byte
Player0_InputSettings .DS 2 ; 0 == current, 1 == previous
;
GameState .byte
LoopIdx .DS 1
;
BlockQueue_Idx      .byte
TimeDec     .byte
	org $A0
BlockQueue_Top_0 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Top_0_Preview .byte
	org $B0
BlockQueue_Top_1 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Top_1_Preview .byte
	org $C0
BlockQueue_Top_2 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Top_2_Preview .byte
	org $D0
BlockQueue_Top_3 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Top_3_Preview .byte
	org $E0
BlockQueue_Top_4 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Top_4_Preview .byte

	org $A8
BlockQueue_Bot_0 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Bot_0_Preview .byte
	org $B8
BlockQueue_Bot_1 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Bot_1_Preview .byte
	org $C8
BlockQueue_Bot_2 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Bot_2_Preview .byte
	org $D8
BlockQueue_Bot_3 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Bot_3_Preview .byte
	org $E8
BlockQueue_Bot_4 .DS  #CONS_BQ_VERT_COLS
;BlockQueue_Bot_4_Preview .byte
;
	org $F0
NumberIdx   .DS 3
ScoreNeg    .byte
Score       .DS 3
Time        .DS 3
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Code segment
    seg Code
    org $f000

Start
    CLEAN_START
    lda #$00 ; TODO -- something better here but it works for now
    sta PlaySoundIdx
    lda #CONS_GAMESTATE_TITLE
    sta GameState
    jmp Kernal_SwitchState
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
Gamestate.Branching
    lda GameState
    cmp #CONS_GAMESTATE_PLAY
    beq GameState.Play
    cmp #CONS_GAMESTATE_GAMEOVER
    beq GameState.GameOver    
GameState.Title
    jmp Kernal_Title
GameState.GameOver
    jmp Kernal_Gameover
GameState.Play
    jmp Kernal_Play
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
Kernal_Play.GotoStart
    lda #CONS_GAMESTATE_TITLE
    sta GameState
    jmp Kernal_SwitchState
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; On Frame Code segment
Kernal_Play
    lda #$02
    sta Player0Pos_Col
    sta BlockQueue_Idx

    lda #$02
    sta Player0Pos_Row
    
    lda #$00
    sta ScoreNeg
    sta NextColorTimerIdx

    lda #$00
    sta TempByte_a
    sta Score+2
    sta Score+1
    lda #$01
    sta Score

    lda #$03
    sta Time+2
    lda #$00
    sta Time+1
    lda #$00
    sta Time

    lda CONS_TIMER_FRAMES_PER_SEC
    sta TimeDec
    
    lda #$00
    sta PlaySoundIdx
    
    ldx NextColorTimerIdx
    lda AddBlockTimers,x
    sta NextColorCounter

    ldx NextColor
    lda Colors,x
    sta Player0_Color
; Setup Other Player Things
    ;jsr GetRandomColor messes up horizontal placement!
    ;Just to easily see end of memory
    ;lda #$EE
    ;sta BlockQueue_Idx+1
    ;lda #$FF
    ;sta BlockQueue_Idx+2
;;;;
.Kernal_Play.NextFrame
    lsr SWCHB      ; test Game Reset switch
    bcc Kernal_Play.GotoStart ; reset?
    VERTICAL_SYNC
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 37 lines of underscan
    TIMER_SETUP CONS_PRESCREEN_LINES
;;;;;;;;;;;;;;;;;;;;;;;
; Set Positions
    WSYNC_REPEATER 1
; Set Player X -- todo make this a pointer and data table affair.
    ldy Player0Pos_Col
    lda (TempPtr_a),y
    ldx #0           ; player 0
    jsr SetHorizPos
    WSYNC_REPEATER 1
    lda #CONS_SCORE_LEFTMOST_DIGIT_X
    ldx #1           ; player 1
    jsr SetHorizPos
    WSYNC_REPEATER 1
    lda #CONS_SCORE_MINUS_SIGN_X
    ldx #02 ; player 0 missle
    jsr SetHorizPos
    nop
    TIMER_WAIT
    TIMER_SETUP CONS_ONSCREEN_LINES
;;;;;;;;;;;;;;;;;;;;;;;
    jsr Kernal_Score_Subroutine
;;;;;;;;;;;;;;;;;;;;;;;
    lda #%00000001
    sta CTRLPF
    lda #CONS_GRID_BRICKS_BG
    sta COLUPF
    
    lda #%11110000
    sta PF0
    lda #%11100111
    sta PF1
    lda #%01111001
    sta PF2
    
    lda #$00
    ldx #CONS_BQ_VERT_ROWS
    WSYNC_REPEATER 1
.Kernal_Play.Blocks.Top
    ;TODO -- honsetly do I need this? Could just try to use the X value!
    ldy #CONS_BQ_VERT_ROW_HEIGHT
.Kernal_Play.Blocks.Top.Rows
    WSYNC_REPEATER 1
    
    lda BlockQueue_Top_0,x
    sta COLUBK
    
    SLEEP 23
    
    lda BlockQueue_Top_1,x
    sta COLUBK
    
    lda BlockQueue_Top_2,x
    sta COLUBK

    lda BlockQueue_Top_3,x
    sta COLUBK

    nop
    
    lda BlockQueue_Top_4,x
    sta COLUBK

    dey
    bne .Kernal_Play.Blocks.Top.Rows
    
    nop
    lda #CONS_COLOR_BLACK
    sta COLUBK
    WSYNC_REPEATER 1
    
    dex
    bpl .Kernal_Play.Blocks.Top
;;;;;;;;;;;;;;;;;;;;;;;
    WSYNC_REPEATER 1
    
    lda #%00000000
    sta PF0
    lda #%00011000
    sta PF1
    lda #%10000110
    sta PF2
    lda #CONS_GRID_CLIFF_BG
    sta TempByte_d
    
    lda #CONS_COLOR_BLACK
    sta COLUPF
    ldy #CONS_CLIFF_HEIGHT
.Kernal_Play.Cliff.Top
    lda TempByte_d
    sta COLUBK
    sec
    sbc #01
    sta TempByte_d
    ldx #CONS_CLIFF_SHADING_GAP
.Kernal_Play.Cliff.Top.ColorBandLoop
    WSYNC_REPEATER 1
    dex 
    bne .Kernal_Play.Cliff.Top.ColorBandLoop
    dey
    bne .Kernal_Play.Cliff.Top
    WSYNC_REPEATER 1
    lda #CONS_COLOR_BLACK
    sta COLUBK
    WSYNC_REPEATER 1
;;;;;;;;;;;;;;;;;;;;;;;
    
    lda #%00000001
    sta CTRLPF
    lda #CONS_PLAYERZONE_PF
    sta COLUPF
    
    lda #%11110000
    sta PF0
    lda #%11111001
    sta PF1
    lda #%01110011
    sta PF2
    
    lda Player0_Color
    sta COLUP0
    
    lda #CONS_PLAYERZ_ROWS
    sta LoopIdx
    ldx #00
.Kernal_Play.PlayerZone
    ldy #CONS_PLAYERZ_ROW_HEIGHT
    
.Kernal_Play.PlayerZone.Rows
    WSYNC_REPEATER 1
    lda PlayerZone_Colors,x ; TODO -- from color data table
    sta COLUBK


.Kernal_Play.PlayerZone.PlayerLogic.ComparePlayer
    lda Player0Pos_Row
    cmp LoopIdx
    bne .Kernal_Play.PlayerZone.SkipPlayer 
.Kernal_Play.PlayerZone.DrawPlayer
    lda #$FF
    jmp .Kernal_Play.PlayerZone.EndPlayer
.Kernal_Play.PlayerZone.SkipPlayer 
    lda #$00
.Kernal_Play.PlayerZone.EndPlayer
    sta GRP0 
    dey
    bne .Kernal_Play.PlayerZone.Rows
    WSYNC_REPEATER 1
    lda #CONS_COLOR_BLACK
    sta COLUBK
    lda #$00
    sta GRP0
    
    inx
    WSYNC_REPEATER 1

    dec LoopIdx
    bne .Kernal_Play.PlayerZone
;;;;;;;;;;;;;;;;;;;;;;;
    WSYNC_REPEATER 1
    
    lda #%00000000
    sta PF0
    lda #%00011000
    sta PF1
    lda #%10000110
    sta PF2

    lda #CONS_COLOR_BLACK
    sta COLUBK
    WSYNC_REPEATER 1

    lda TempByte_d
    sta COLUBK
    
    lda #CONS_COLOR_BLACK
    sta COLUPF
    ldy #CONS_CLIFF_HEIGHT
.Kernal_Play.Cliff.Bot
    lda TempByte_d
    sta COLUBK
    clc
    adc #01
    sta TempByte_d
    ldx #CONS_CLIFF_SHADING_GAP
.Kernal_Play.Cliff.Bot.ColorBandLoop
    WSYNC_REPEATER 1
    dex 
    bne .Kernal_Play.Cliff.Bot.ColorBandLoop
    dey
    bne .Kernal_Play.Cliff.Bot
    lda #CONS_COLOR_BLACK
    sta COLUBK
    WSYNC_REPEATER 1
;;;;;;;;;;;;;;;;;;;;;;;
    lda #%00000001
    sta CTRLPF
    lda #CONS_GRID_BRICKS_BG
    sta COLUPF
    
    lda #%11110000
    sta PF0
    lda #%11100111
    sta PF1
    lda #%01111001
    sta PF2
    
    lda #$00
    ldx #00
    WSYNC_REPEATER 1
.Kernal_Play.Blocks.Bot
    ;TODO -- honsetly do I need this? Could just try to use the X value!
    ldy #CONS_BQ_VERT_ROW_HEIGHT
.Kernal_Play.Blocks.Bot.Rows
    WSYNC_REPEATER 1
    
    lda BlockQueue_Bot_0,x
    sta COLUBK
    
    SLEEP 23
    
    lda BlockQueue_Bot_1,x
    sta COLUBK
    
    lda BlockQueue_Bot_2,x
    sta COLUBK

    lda BlockQueue_Bot_3,x
    sta COLUBK

    nop
    
    lda BlockQueue_Bot_4,x
    sta COLUBK

    dey
    bne .Kernal_Play.Blocks.Bot.Rows
    
    nop
    lda #CONS_COLOR_BLACK
    sta COLUBK
    WSYNC_REPEATER 1
    
    inx
    txa
    cmp #CONS_BQ_VERT_ROWS+1
    bmi .Kernal_Play.Blocks.Bot
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    jsr Kernal_Time_Subroutine
.Kernal_Play.lowerBuffer
    WSYNC_REPEATER 3
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.Kernal_Play.StopVisuals
    lda #00
    sta GRP0
    sta GRP1
    sta ENAM0
    sta ENAM1
    
    lda #CONS_COLOR_BLACK
    sta COLUBK
    sta COLUPF
    
    lda #%00000000
    sta PF0
    lda #%00000000
    sta PF1
    lda #%00000000
    sta PF2
    
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.Kernal_Play.DecrementTimer.Tick
    dec TimeDec
    bne .Kernal_Play.WaitTilEnd
    lda CONS_TIMER_FRAMES_PER_SEC
    sta TimeDec
.Kernal_Play.DecrementTimer.Decrement
    sed
    dec Time
    bpl .Kernal_Play.ClearMath
    lda #$09
    sta Time
    dec Time+1
    bpl .Kernal_Play.ClearMath
    lda #$09
    sta Time+1
    dec Time+2
    bpl .Kernal_Play.ClearMath
    lda #$09
    sta Time+2
.Kernal_Play.TestTimeOver
    lda Time
    adc Time+1
    adc Time+2
    CMP #$27 ; if its time over we hit 9s in all columns
    bne .Kernal_Play.ClearMath
    SET_SOUND $04, $10
    lda #CONS_GAMESTATE_GAMEOVER
    sta GameState
    jmp Kernal_SwitchState
.Kernal_Play.ClearMath
    cld
.Kernal_Play.BlockCounter.IncTimerIdxc
    dec NextColorCounter
    bne .Kernal_Play.WaitTilEnd
    lda NextColorTimerIdx
    cmp #06; amount of entries we have in AddBlockTimers - 1
    bcs .Kernal_Play.BlockCounter.IncTimerIdxc.IncTimerIdx
    inc NextColorTimerIdx
.Kernal_Play.BlockCounter.IncTimerIdxc.IncTimerIdx
    ldx NextColorTimerIdx
    lda AddBlockTimers,x
    sta NextColorCounter
    jsr GetRandomColor
    jsr GetRandomQueue
    jsr setRandomBlock
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.Kernal_Play.WaitTilEnd
    jsr ReadJoystick
    jsr setBlockQueueIdx 
    nop  ; at: 199 of 233 lines by this point, dont cross! note in PIA will be 232 if right.
    TIMER_WAIT
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 29 lines of overscan
Kernal_Overscan
    TIMER_SETUP 29 ; may meed more? at 257
    lda PlaySoundCounter
    beq Kernal_Overscan.soundOff
    dec PlaySoundCounter
    ldx PlaySoundIdx
    lda Sounds_AUDC0,x
    sta AUDC0
    lda Sounds_AUDF0,x
    sta AUDF0
    lda Sounds_AUDV0,x
    sta AUDV0
    jmp Kernal_Overscan.skip
Kernal_Overscan.soundOff
    SET_SOUND $00, $01
Kernal_Overscan.skip
    nop
    TIMER_WAIT
; total = 262 lines, go to next frame
    jmp .Kernal_Play.NextFrame

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Subroutines
SetPositionMissles 
    WSYNC_REPEATER 1
    lda #46 ;#46
    ldx #2           ; player 0 Missle
    jsr SetHorizPos

    WSYNC_REPEATER 1
    lda #62
    ldx #3           ; player 1 Missle
    jsr SetHorizPos
    rts
;;;;;;;;;;;;;;;;;;;;;;;    
; A = X coordinate
; X = player number (0 or 1)
SetHorizPos
        WSYNC_REPEATER 1	; start a new line
        sec		; set carry flag
.SetHorizPos.1
	sbc #15		; subtract 15
	bcs .SetHorizPos.1 ; branch until negative
	eor #7		; calculate fine offset
        asl
        asl
        asl
        asl
        sta RESP0,x	; fix coarse position
        sta HMP0,x	; set fine offset
        WSYNC_REPEATER 1
        sta HMOVE	; apply the previous fine position(s)
        SLEEP 24
	    sta HMCLR	; reset the old horizontal position(s)
        rts		; return to caller
;;;;;;;;;;;;;;;;;;;;;;;    
; 
; 
handleFireButton
    ; -- we need to be able to go to the 
    lda Player0Pos_Row
    cmp #$02
    beq .handleFireButton.NoAction
    ldy BlockQueue_Idx
    lda (TempPtr_c),y
    sta TempPtr_b
    lda #>00
    sta TempPtr_b+1

    ldy #00 
.handleFireButton.FindRowMem
    tya
    cmp #CONS_BQ_VERT_ROW_HEIGHT+2 ; if we are at our limit, goto the END
    beq .handleFireButton.NoAction
    ; --- now look at blocks
    tay
    lda (TempPtr_b),y
    cmp #CONS_COLOR_BLACK  ; ----------    is empty
    beq .handleFireButton.gotoNextBlock
    cmp  Player0_Color  ; ----------    is player color
    beq .handleFireButton.MatchingColor
    jmp .handleFireButton.swapWithBlock
.handleFireButton.MatchingColor
    ; here we will loop through the columns blacking out all of the
    lda #CONS_COLOR_BLACK
    sta (TempPtr_b),y
    ; now do some score
    jsr addScore
.handleFireButton.gotoNextBlock
    iny
    cmp #$00 ; is our accumulator 0?
    bcs .handleFireButton.FindRowMem
.handleFireButton.swapWithBlock
    lda (TempPtr_b),y
    sta TempByte_a
    lda Player0_Color
    sta (TempPtr_b),y
    lda TempByte_a
    sta Player0_Color
    jsr subtractScore
.handleFireButton.NoAction
    rts
;;;;;;;;;;;;;;;;;;;;;;;    
; 
; 
setBlockQueueIdx
     ; rows count from bottom UP apparently! starting at 1. my bad?
    ldy #$00
    lda Player0Pos_Row
    cmp #01
    bne .setBlockQueueIdx.noRowChange
    REPEAT CONS_BQ_VERT_COLS
        iny
    REPEND 
.setBlockQueueIdx.noRowChange
    tya
    clc
    adc Player0Pos_Col
    sta BlockQueue_Idx
    rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;-----------------------------------------
; SWCHA -- directional register
; #%10000000 -- P1 Right
; #%01000000 -- P1 left
; #%00100000 -- P1 down
; #%00010000 -- P1 up
; #%00001000 -- P0 Right
; #%00000100 -- P0 left
; #%00000010 -- P0 down
; #%00000001 -- P0 up
ReadJoystick
      lda #%00000000
      sta Player0_InputSettings  ; Set current input state to 0
; ----------------------
; LEFT
; ----------------------
      lda #%01000000
      bit SWCHA
      bne .checkRight

      lda Player0_InputSettings
      ora #%00000001
      sta Player0_InputSettings

; ----------------------
; RIGHT
; ----------------------
.checkRight
      lda #%10000000
      bit SWCHA
      bne .checkUp

      lda Player0_InputSettings
      ora #%00000010
      sta Player0_InputSettings

; ----------------------
; UP
; ----------------------
.checkUp
      lda #%00010000
      bit SWCHA
      bne .checkDown

      lda Player0_InputSettings
      ora #%00001000
      sta Player0_InputSettings

; ----------------------
; DOWN
; ----------------------
.checkDown
      lda #%00100000
      bit SWCHA
      bne .checkbutton

      lda Player0_InputSettings
      ora #%00010000
      sta Player0_InputSettings
      
.checkbutton
      bit INPT4
      bmi .determineJoystickAction ; released
      lda Player0_InputSettings
      ora #%00000100
      sta Player0_InputSettings
      
.determineJoystickAction
        lda Player0_InputSettings
        bne .storeCurrentInput
        lda Player0_InputSettings+1
        beq .storeCurrentInput

        tax
        ; Fire on release
        and #%00000100
        bne .fireOnRelease

; LEFT RELEASE
      txa
      and #%00000001
      bne .leftOnRelease

; RIGHT RELEASE
      txa
      and #%00000010
      bne .rightOnRelease

; UP RELEASE
      txa
      and #%00001000
      bne .upOnRelease

; DOWN RELEASE
      txa
      and #%00010000
      bne .downOnRelease
.leftOnRelease
    lda Player0Pos_Col
    cmp #$00
    beq .storeCurrentInput
    dec Player0Pos_Col
    ;SET_SOUND $01, $03
    jmp .storeCurrentInput
.rightOnRelease
    lda Player0Pos_Col
    cmp #CONS_PLAYERZ_COLS-2
    beq .storeCurrentInput
    inc Player0Pos_Col
    ;SET_SOUND $01, $03
    jmp .storeCurrentInput
.upOnRelease
    lda Player0Pos_Row
    cmp #CONS_PLAYERZ_ROWS
    beq .storeCurrentInput
    inc Player0Pos_Row
    ;SET_SOUND $01, $03
    jmp .storeCurrentInput
.downOnRelease
    lda Player0Pos_Row
    cmp #$01
    beq .storeCurrentInput
    dec Player0Pos_Row
    ;SET_SOUND $01, $03
    jmp .storeCurrentInput
.fireOnRelease
    jsr handleFireButton
    lda ScoreNeg
    bne .fireOnRelease.soundB
.fireOnRelease.soundA
    SET_SOUND $01, $03
    jmp .storeCurrentInput
.fireOnRelease.soundB
    SET_SOUND $02, $03
.storeCurrentInput
    lda Player0_InputSettings
    sta Player0_InputSettings+1
.endJoystickCheck
      rts
;;;;;;;;;;;;;;;;;;;;;;;    
; 
; 
addScore
    sta TempByte_a
    sed
    lda ScoreNeg
    beq .addScore.positive
    jmp .addScore.negative
.addScore.positive
    clc
    lda Score
    adc #02
    sta Score
    cmp #$10
    bne .addScore.end
    clc
    lda Score+1
    adc #$01
    sta Score+1
    cmp #$10
    bne .addScore.end
    clc
    lda Score+2
    adc #$01
    sta Score+2
    jmp .addScore.end
.addScore.negative
    sec
    lda Score
    sbc #01
    sta Score
    bpl .addScore.checkZero
    sec
    lda Score+1
    sbc #01
    sta Score+1
    bpl .addScore.checkZero
    sec
    lda Score+2
    sbc #01
    sta Score+2
.addScore.checkZero
    lda Score
    ora Score+1
    ora Score+2
    beq .addScore.clearSign
    jmp .addScore.end
.addScore.clearSign
    lda #$00
    sta ScoreNeg
.addScore.end
    cld ; turn off decimal math
    lda TempByte_a
    rts
;;;;;;;;;;;;;;;;;;;;;;;    
;
subtractScore
    sta TempByte_a
    sed
    lda ScoreNeg
    bne .subtractScore.negative
    jmp .subtractScore.positive
.subtractScore.positive
    sec
    lda Score
    sbc #01
    sta Score
    bpl .subtractScore.end
    sec
    lda Score+1
    sbc #01
    sta Score+1
    bpl .subtractScore.end
    sec
    lda Score+2
    sbc #01
    sta Score+2
    bcc .subtractScore.flipSign
    jmp .subtractScore.end
.subtractScore.flipSign
    lda #$01
    sta Score
    lda #$00
    sta Score+1
    sta Score+2
    lda #$01
    sta ScoreNeg
    jmp .subtractScore.end
.subtractScore.negative
    clc
    lda Score
    adc #01
    sta Score
    cmp #$10
    bne .subtractScore.end
    clc
    lda Score+1
    adc #$01
    sta Score+1
    cmp #$10
    bne .subtractScore.end
    clc
    lda Score+2
    adc #$01
    sta Score+2
.subtractScore.end
    cld ; turn off decimal math
    lda TempByte_a
    rts
;;;;;;;;;;;;;;;;;;;;;;;    
setRandomBlock
    ldy NextColumn
    lda (TempPtr_c),y
    sta TempPtr_b
    lda #>00
    sta TempPtr_b+1
    ldy #CONS_BQ_VERT_ROWS
.setRandomBlock.testIfEmpty
    lda (TempPtr_b),y
    cmp #CONS_COLOR_BLACK
    beq .setRandomBlock.shiftBlocks.setNextColor
    ldy #$00
.setRandomBlock.testIfFull
    lda (TempPtr_b),y
    cmp #CONS_COLOR_BLACK
    beq .setRandomBlock.shiftBlocks
    SET_SOUND $04, $10
    lda #CONS_GAMESTATE_GAMEOVER
    sta GameState
    jmp Kernal_SwitchState
.setRandomBlock.shiftBlocks
    tya
    cmp #CONS_BQ_VERT_ROWS
    beq .setRandomBlock.shiftBlocks.setNextColor
    tay
    iny
    lda (TempPtr_b),y
    dey
    sta (TempPtr_b),y
    iny
    jmp .setRandomBlock.shiftBlocks
.setRandomBlock.shiftBlocks.setNextColor
    ldx NextColor
    lda Colors,x
    ldy #CONS_BQ_VERT_ROWS
    sta (TempPtr_b),y
    SET_SOUND $03, $05
    rts
;;;;;;;;;;;;;;;;;;;;;;;
; GetRandomColor
; Generates a pseudo-random value using a Linear Feedback Shift Register
; Returns: A = random value, NextColor = random value - 1 (for 0-6 range)
; Modifies: Random variable
GetRandomColor
    lda Random
    lsr
    bcc .GetRandomColor.noXor
    eor #$B8
.GetRandomColor.noXor
    bne .GetRandomColor.done  ; If not 0, done
    lda #$01
.GetRandomColor.done
    sta Random
.GetRandomColor.convert
    and #$07
    cmp #$06
    bcs GetRandomColor
.GetRandomColor.convert.done
    sta NextColor
    rts
;;;;;;;;;;;;;;;;;;;;;;;
; GetRandomQueue
; Generates a pseudo-random value using a Linear Feedback Shift Register
; Returns: A = random value, NextColumn = random value - 1 (for 0-10 range)
; Modifies: Random variable    
GetRandomQueue
    lda Random
    lsr
    bcc .GetRandomQueue.noXor
    eor #$B8
.GetRandomQueue.noXor
    bne .GetRandomQueue.done  ; If not 0, done
    lda #$01
.GetRandomQueue.done
    sta Random
.GetRandomQueue.convert
    and #$0F
    cmp #$0A
    bcs GetRandomQueue
.GetRandomQueue.convert.done
    sta NextColumn
    rts
;;;;;;;;;;;;;;;;;;;;;;;
; setupVarsPointers
; Used to setup any pointers or variables we'll use  in a specific game state
; Author: Andy Garber
setupVarsPointers
    lda GameState
    cmp #CONS_GAMESTATE_PLAY
    beq .setupVarsPointers.Play
    cmp #CONS_GAMESTATE_GAMEOVER
    beq .setupVarsPointers.GameOver
.setupVarsPointers.Title
    LOAD_POINTER_WITH_DATA TempPtr_a,Title_Screen_PF1_LEFT
    LOAD_POINTER_WITH_DATA TempPtr_b,Title_Screen_PF1_RIGHT
    LOAD_POINTER_WITH_DATA TempPtr_c,Title_Screen_PF2_LEFT
    LOAD_POINTER_WITH_DATA TempPtr_d,Colors

    LOAD_POINTER_WITH_DATA NextColorTimerIdx,Title_Screen_Option1_Sprite1
    LOAD_POINTER_WITH_DATA TempByte_a,Title_Screen_Option1_Sprite2
    LOAD_POINTER_WITH_DATA TempByte_c,Title_Screen_Option1_Sprite3

    LOAD_POINTER_WITH_DATA NextColumn,Title_Screen_Option2_Sprite1
    LOAD_POINTER_WITH_DATA Player0Pos_Col,Title_Screen_Option2_Sprite2
    LOAD_POINTER_WITH_DATA Player0_Color,Title_Screen_Option2_Sprite3
    jmp .setupVarsPointers.End
.setupVarsPointers.GameOver
    jmp .setupVarsPointers.End
.setupVarsPointers.Play
    LOAD_POINTER_WITH_DATA TempPtr_a,PlayerPositions_Columns
    LOAD_POINTER_WITH_DATA TempPtr_c,PlayerColMemAddresses
.setupVarsPointers.End
    rts
;;;;;;;;;;;;;;;;;;;;;;;
; Kernal_SwitchState
; used to just give us a clean place to switch our game states
; No vars used. set GAMESTATE before you come here!
Kernal_SwitchState
    VERTICAL_SYNC
    ;;;;;;;;;;;;;;;;;;;;;;;;;
    TIMER_SETUP CONS_PRESCREEN_LINES
    lda INTIM           ; Use the timer counter value
    cmp #$00
    bne .Kernal_SwitchState.setRandomSeed
    lda #$87
.Kernal_SwitchState.setRandomSeed
    sta Random
.Kernal_SwitchState.setupVarsPointers
    jsr setupVarsPointers
    WSYNC_REPEATER 1
    TIMER_WAIT
    ;;;;;;;;;;;;;;;;;;;;;;;;;
    TIMER_SETUP CONS_ONSCREEN_LINES
    WSYNC_REPEATER 1
    jsr InitializeRows
    TIMER_WAIT
    ;;;;;;;;;;;;;;;;;;;;;;;;;
    TIMER_SETUP CONS_OFFSCREEN_LINES
    WSYNC_REPEATER 1
    TIMER_WAIT
    ;;;;;;;;;;;;;;;;;;;;;;;;;
    jmp Gamestate.Branching
;;;;;;;;;;;;;;;;;;;;;;;
; Kernal_Title
; ----------- Temp Variables -----------
; TempByte_a = pointer to Option 1 Sprite 2
; TempByte_b = Unused
; TempByte_c = pointer to Option 1 Sprite 3
; TempByte_d = Unused
; TempPtr_a = pointer to Title_Screen_PF1_LEFT
; TempPtr_b = pointer to Title_Screen_PF1_RIGHT
; TempPtr_c = pointer to Title_Screen_PF2_LEFT
; TempPtr_d = pointer to Colors
; NextColorTimerIdx = pointer to Option 1 Sprite 1
; NextColor = pointer to Option 2 Sprite 1
; Player0Pos_Col = pointer to Option 2 Sprite 2
; Player0_Color = pointer to Option 2 Sprite 3
; NumberIdx   = the option underlined
; NumberIdx+1 = the digit for Optiona A
; NumberIdx+2 = the digit for Option B
Kernal_Title.SwitchState
    lda #CONS_GAMESTATE_PLAY
    sta GameState
    jmp Kernal_SwitchState
Kernal_Title
    SWITCH_STATE_BY_FIRE Kernal_Title.SwitchState
    VERTICAL_SYNC
    TIMER_SETUP CONS_PRESCREEN_LINES
    lda #%00000001
    sta CTRLPF
    ; TODO -- actually implement the characters here
    lda #%00000001
    sta NUSIZ0
    lda #%00000100
    sta NUSIZ1
    lda #CONS_COLOR_WHITE
    sta COLUPF
    sta COLUP0
    lda #CONS_COLOR_TEAL
    sta COLUP1
;;;;;;
.Kernal_Title.SetPositions
    WSYNC_REPEATER 1
    lda #60 ; Player 0 Position
    ldx #0           ; player 0
    jsr SetHorizPos
    WSYNC_REPEATER 1
    lda #68
    ldx #1   ; Player 1 Position
    jsr SetHorizPos
    WSYNC_REPEATER 1
    TIMER_WAIT
    TIMER_SETUP CONS_ONSCREEN_LINES
;;;;;;
    ldy #60
.Kernal_Title.TopGap
    WSYNC_REPEATER 1
    dey
    bne .Kernal_Title.TopGap
;;;;;;
    WSYNC_REPEATER 1
    ldy #5
.Kernal_Title.Letters
    lda (TempPtr_d),y
    sta COLUBK
;;;;;;
    ldx #10
.Kernal_Title.WritePF
    WSYNC_REPEATER 1
    lda (TempPtr_a),y
    sta PF1
    lda (TempPtr_c),y
    sta PF2
    SLEEP 13
    lda (TempPtr_b),y
    sta PF1
    dex
    bne .Kernal_Title.WritePF
    dey 
    bpl .Kernal_Title.Letters
;;;;;;
.Kernal_Title.BufferBot
    lda #CONS_COLOR_BLACK
    sta COLUPF
    sta COLUBK
    lda #%00000000
    sta PF0
    sta PF1
    sta PF2
    ; TODO -- add some smaller caption
    WSYNC_REPEATER 20
    lda #$00
    sta NumberIdx
    ldy #$05
.Kernal_Title.Option1
    lda (TempByte_c),y
    tax
    lda (NextColorTimerIdx),y
    sta GRP0
    lda (TempByte_a),y
    sta GRP1
    SLEEP 10
    stx GRP0
    ldx NumberIdx
    lda Score_Numbers,x
    sta GRP1
    WSYNC_REPEATER 1
    inc NumberIdx
    dey
    bpl .Kernal_Title.Option1
    lda #$00
    sta GRP0
    sta GRP1
;;;;;;;;;;;;;;;;;;
    WSYNC_REPEATER 3
    lda #$00
    sta NumberIdx
    ldy #$05
.Kernal_Title.Option2
    lda (Player0_Color),y
    tax
    lda (NextColumn),y
    sta GRP0
    lda (Player0Pos_Col),y
    sta GRP1
    SLEEP 8
    stx GRP0
    ldx NumberIdx
    lda Score_Numbers,x
    sta GRP1
    WSYNC_REPEATER 1
    inc NumberIdx
    dey
    bpl .Kernal_Title.Option2
    lda #$00
    sta GRP0
    sta GRP1
    TIMER_WAIT
.Kernal_Title.Overscan
    TIMER_SETUP CONS_OFFSCREEN_LINES
    ; TODO -- title music!
    WSYNC_REPEATER 1
    TIMER_WAIT
    jmp Kernal_Title
;;;;;;;;;;;;;;;;;;;;;;;
;
;
Kernal_Gameover.GotoStart
    lda #CONS_GAMESTATE_PLAY
    sta GameState
    jmp Kernal_SwitchState
Kernal_Gameover
    SWITCH_STATE_BY_FIRE Kernal_Gameover.GotoStart
    VERTICAL_SYNC
    TIMER_SETUP CONS_PRESCREEN_LINES
    WSYNC_REPEATER 1
    TIMER_WAIT
    TIMER_SETUP CONS_ONSCREEN_LINES
    ldy #60
.Kernal_Gameover.TopGap
    WSYNC_REPEATER 1
    dey
    bne .Kernal_Gameover.TopGap
;;;;;;
    jsr Kernal_Score_Subroutine
    jsr Kernal_Time_Subroutine
;;;;;;
.Kernal_Gameover.Bottom
    lda #CONS_COLOR_BLACK
    sta COLUPF
    sta COLUBK
    lda #%00000000
    sta PF0
    sta PF1
    sta PF2
    WSYNC_REPEATER 1
    TIMER_WAIT
.Kernal_Gameover.Overscan
    TIMER_SETUP CONS_OFFSCREEN_LINES
    lda PlaySoundCounter
    beq .Kernal_Gameover.soundOff
    dec PlaySoundCounter
    ldx PlaySoundIdx
    lda Sounds_AUDC0,x
    sta AUDC0
    lda Sounds_AUDF0,x
    sta AUDF0
    lda Sounds_AUDV0,x
    sta AUDV0
    jmp .Kernal_Gameover.skip
.Kernal_Gameover.soundOff
    SET_SOUND $00, $01
.Kernal_Gameover.skip
    TIMER_WAIT
    jmp Kernal_Gameover
;;;;;;;;;;
;
;
Kernal_Score_Subroutine
    lda #%0110000
    sta NUSIZ0
    lda #%1000110
    sta NUSIZ1
    lda #CONS_COLOR_BLACK
    sta COLUP0
    sta COLUP1
    
    WSYNC_REPEATER 1
    lda ScoreNeg
    bne .Kernal_Score.Prescore.isNegativeColor
.Kernal_Score.Prescore.isPositiveColor
    lda #CONS_SCORE_POSITIVE
    sta COLUBK
    jmp .Kernal_Score.Prescore.getNibbles  
.Kernal_Score.Prescore.isNegativeColor    
    lda #CONS_SCORE_NEGATIVE
    sta COLUBK
.Kernal_Score.Prescore.getNibbles    
    ; -- Always set the digit right nibble, we'll probably do this LATER in the code
    lda Score
    and #$0F
    sta Score
    lda Score+1
    and #$0F
    sta Score+1
    lda Score+2
    and #$0F
    sta Score+2
    ;-- loop over EVERY digit
    
    ldx #02
.Kernal_Score.Prescore.setNumAddresses
    ldy Score,x
    clc
    lda #$05 ; 0 ALWAYS starts at 5
.Kernal_Score.Prescore.loopaddress
    dey
    bmi .Kernal_Score.Prescore.addTempByte_a
    adc #$06
    jmp .Kernal_Score.Prescore.loopaddress
.Kernal_Score.Prescore.addTempByte_a  
    sta NumberIdx,x
    dex
    bpl .Kernal_Score.Prescore.setNumAddresses
    ;----------------
    ldy #$06
.Kernal_Score
    WSYNC_REPEATER 1
    lda ScoreNeg
    beq .Kernal_Score.extraDelay
    lda Minus_Sign,y
    sta ENAM0
    jmp .Kernal_Score.printDigits
.Kernal_Score.extraDelay
    SLEEP 9
.Kernal_Score.printDigits
    SLEEP 7
    ldx NumberIdx+2
    lda Score_Numbers,x
    sta GRP1

    ldx NumberIdx+1
    lda Score_Numbers,x
    sta GRP1
    
    ldx NumberIdx
    lda Score_Numbers,x
    sta GRP1

    dec NumberIdx
    dec NumberIdx+1
    dec NumberIdx+2
    
    lda #$00
    sta GRP1
    WSYNC_REPEATER 1; -- todo why is this SO angry!
    
    dey
    bne .Kernal_Score
.Kernal_Score.PostScore
    WSYNC_REPEATER 1
    lda #$00
    sta GRP1
    sta ENAM0
    WSYNC_REPEATER 2
    lda #CONS_COLOR_BLACK
    sta COLUPF
    sta COLUBK
    WSYNC_REPEATER 2
    rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
Kernal_Time_Subroutine  
    lda #%00000000
    sta PF0
    lda #%00000000
    sta PF1
    lda #%00000000
    sta PF2
    WSYNC_REPEATER 2
    lda #CONS_TIME_BG
    sta COLUBK
    ; -- Always set the digit right nibble, we'll probably do this LATER in the code
    lda Time
    and #$0F
    sta Time
    lda Time+1
    and #$0F
    sta Time+1
    lda Time+2
    and #$0F
    sta Time+2
    ;-- loop over EVERY digit
    ldx #02
.Kernal_PreTime.setNumAddresses
    ldy Time,x
    clc
    lda #$05 ; 0 ALWAYS starts at 5
.Kernal_PreTime.loopaddress
    dey
    bmi .Kernal_PreTime.addTempByte_a
    adc #$06
    jmp .Kernal_PreTime.loopaddress
.Kernal_PreTime.addTempByte_a  
    sta NumberIdx,x
    dex
    bpl .Kernal_PreTime.setNumAddresses
    ;----------------
    ldy #$06
.Kernal_Time
    WSYNC_REPEATER 1
    SLEEP 23 
    ldx NumberIdx+2
    lda Score_Numbers,x
    sta GRP1

    ldx NumberIdx+1
    lda Score_Numbers,x
    sta GRP1
    
    ldx NumberIdx
    lda Score_Numbers,x
    sta GRP1

    dec NumberIdx
    dec NumberIdx+1
    dec NumberIdx+2
    
    lda #$00
    sta GRP1
    WSYNC_REPEATER 1!
    
    dey
    bne .Kernal_Time
    rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
InitializeRows    
    ldy #$08
.InitializeRows.Empty
    lda #$00
    sta BlockQueue_Top_0,y
    sta BlockQueue_Top_1,y
    sta BlockQueue_Top_2,y
    sta BlockQueue_Top_3,y
    sta BlockQueue_Top_4,y
    sta BlockQueue_Bot_0,y
    sta BlockQueue_Bot_1,y
    sta BlockQueue_Bot_2,y
    sta BlockQueue_Bot_3,y
    sta BlockQueue_Bot_4,y
    dey
    bne .InitializeRows.Empty

    ldy #CONS_BQ_VERT_ROWS
.InitializeRows.Fill
    ;TOP
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Top_0,y
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Top_1,y
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Top_2,y
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Top_3,y    
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Top_4,y
    ;BOT
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Bot_0,y
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Bot_1,y
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Bot_2,y
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Bot_3,y    
    jsr GetRandomColor
    ldx NextColor
    lda Colors,x
    sta BlockQueue_Bot_4,y
.InitializeRows.Fill.Next
    dey
    tya
    cmp #CONS_BQ_VERT_ROWS-1
    bcs .InitializeRows.Fill
    rts

